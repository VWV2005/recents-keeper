# Copy this file to keystore.properties (which is git-ignored) to sign a release
# build with your own key. Without it, build.sh falls back to a throwaway debug
# key so that a plain clone still produces an installable APK.
#
# The same four values can be supplied as environment variables instead:
#   RK_KEYSTORE, RK_KEYSTORE_PASS, RK_KEY_ALIAS, RK_KEY_PASS

storeFile=/absolute/path/to/your-release.jks
storePassword=change-me
keyAlias=change-me
keyPassword=change-me
